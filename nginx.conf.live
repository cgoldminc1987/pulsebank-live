server {
  listen 443 ssl;
  server_name api.pulsebank.ca;

  ssl_certificate     /etc/letsencrypt/live/api.pulsebank.ca/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.pulsebank.ca/privkey.pem;

  # Static app: /app/ -> /opt/pulsebank/public/app/index.html
  location /app/ {
    root /opt/pulsebank/public;
    index index.html;
    try_files $uri $uri/ /app/index.html;
  }

  location = /app {
    return 301 /app/;
  }

  # The app's own nav links to /commands - send it to the SPA
  location = /commands {
    return 301 /app/;
  }

  # API: NO trailing slash on proxy_pass, otherwise /api/v1/... is rewritten to /v1/... and 404s
  location /api/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Idempotency-Key $http_x_idempotency_key;
    proxy_read_timeout 30s;
  }

  location /health {
    proxy_pass http://127.0.0.1:3000;
  }

  # Apple Wallet .pkpass files generated by POST /api/v1/cards/:id/wallet
  location /wallet/ {
    proxy_pass http://127.0.0.1:3000;
  }
}

server {
  listen 80;
  server_name api.pulsebank.ca;
  return 301 https://$host$request_uri;
}
